# Email Delivery Toggle (true in production, false in local dev/testing)
EMAIL_SEND_ENABLED=false

# Internal Corporate SMTP Relay Configuration (Unauthenticated Relay on Port 25)
SMTP_HOST="10.45.0.12"
SMTP_PORT=25
SMTP_SECURE=false
