# ==============================================================================
# IMPACT Model — Environment Configuration Template (.env.example)
# Copy this file to .env in your backend deployment directory (e.g. server/.env)
# DO NOT COMMIT LIVE PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Server Network Configuration
PORT=7000
NODE_ENV=production

# Database Configuration (SQLite default; can be set to PostgreSQL / SQL Server)
# For SQLite, the path is relative to the server/ directory:
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Generate a strong 64-character random string for production)
JWT_SECRET="replace-with-secure-random-secret-key-at-least-32-chars-long"

# NeST Digital Corporate Integrations (HRMS & CRM APIs)
# Base URL of internal corporate HRMS endpoint for employee authentication & hierarchy lookup:
CORPORATE_API_URL="https://hrapps.nestdigital.com:8089"

# Endpoints for pushing leads and fetching stage progression updates:
CRM_API_URL="https://hrapps.nestdigital.com:8089/api/leads/opportunities"
CRM_STATUS_API_URL="https://hrapps.nestdigital.com:8089/api/leads/opportunities/status-changes"

# Production Deep Links & Reverse Proxy Configuration
# Public frontend URL accessed by end users (used to generate links in email notifications):
IMPACT_BASE_URL="https://hrapps.nestdigital.com:8085"

# Allowed CORS Origins (comma-separated URLs allowed to make API requests to port 7000):
CORS_ORIGINS="https://hrapps.nestdigital.com:8085,http://hrapps.nestdigital.com:8085,http://localhost:5173"

# SMTP Email Dispatcher Configuration
# Set to 'true' in production to send real emails via corporate relay; 'false' in local dev to queue in outbox:
EMAIL_SEND_ENABLED=false

# Corporate SMTP Relay Server (Internal Unauthenticated Relay on Port 25)
SMTP_HOST="10.45.0.12"
SMTP_PORT=25
SMTP_SECURE=false

# Sender Identification
SMTP_FROM="peopleexperience@nestgroup.net"
SMTP_FROM_NAME="NeST People Experience Team"
